# ============================================================================
# ESP32-S31-Korvo-1 流媒体音乐播放器  sdkconfig.defaults
#
# 注意：components/gen_bmgr_codes/board_manager.defaults 由 esp_board_manager
#       生成，**优先级高于本文件**。凡芯片/开发板级配置（CPU 频率、PSRAM 模式、
#       Codec 选型、Flash 参数）一律以 board_manager.defaults 为准，本文件只放
#       项目自身的软件配置，不重复声明板级项。
#
# 参考：开发指南 9.1；与官方 esp_board_manager 示例冲突时以官方为准。
# ============================================================================

# ---------------------------------------------------------------------------
# 音频管线（esp_audio_simple_player / ESP-GMF）
#   本板 I2S 固定 48 kHz / 16 bit / 2ch TDM，所以重采样目标设 48000，
#   并打开声道与位深转换，保证交给 ES8389 的 PCM 格式恒定。
# ---------------------------------------------------------------------------
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_RESAMPLE_EN=y
CONFIG_AUDIO_SIMPLE_PLAYER_RESAMPLE_DEST_RATE=48000
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_CH_CVT_EN=y
CONFIG_AUDIO_SIMPLE_PLAYER_CH_CVT_DEST=2
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_BIT_CVT_EN=y
CONFIG_AUDIO_SIMPLE_PLAYER_BIT_CVT_DEST_16BIT=y

# ---------------------------------------------------------------------------
# 射频共存：Wi-Fi 与经典蓝牙共用 2.4 GHz，必须开启
# ---------------------------------------------------------------------------
CONFIG_SW_COEXIST_ENABLE=y

# ---------------------------------------------------------------------------
# 经典蓝牙（片内 BR/EDR，A2DP Source + AVRCP Target）
#
# 本工程只用经典蓝牙（A2DP 源推流给耳机/音箱），**不要开 BLE**：
#   控制器的工作模式由 CONFIG_BTDM_CTRL_MODE_* 这一组选择项决定，默认是
#   BLE_ONLY。BLE_ONLY 下 BR/EDR 射频根本没起来，而
#   bt_service_init() 调的是 esp_bt_controller_enable(ESP_BT_MODE_CLASSIC_BT)，
#   于是经典蓝牙不可用：esp_bluedroid_init() 在等 BR/EDR 控制器的 HCI 应答时
#   卡住，bt_service 永远停在 BT_ST_UNINIT —— 设置页的蓝牙扫描点不动
#   （"蓝牙不可用（初始化失败或未就绪）"）。
#   官方 esp_bt_audio 示例 examples/bt_audio/sdkconfig.defaults.esp32s31.classic
#   就是"只留经典蓝牙 + BTDM_CTRL_MODE_BR_EDR_ONLY"。
#   注意：BTDM_CTRL_MODE_BR_EDR_ONLY=y 之后，Kconfig 里
#   `config BT_BLE_ENABLED depends on BT_BLUEDROID_ENABLED && (!BTDM_CTRL_MODE_BR_EDR_ONLY)`
#   会让 BLE 选项**直接消失**（自动为 n），所以这里不必再写 CONFIG_BT_BLE_ENABLED=n
#   （写了对不可见符号赋值，confgen 会告警"undefined symbol"）。
# ---------------------------------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
# 控制器只跑 BR/EDR（必须与 bt_service.cc 里的 ESP_BT_MODE_CLASSIC_BT 一致）
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y

# ---------------------------------------------------------------------------
# LVGL 9.5
# ---------------------------------------------------------------------------
CONFIG_LV_COLOR_DEPTH_16=y
# 深色主题：LVGL 默认是浅色主题，不打开的话派生控件会是浅底深字
CONFIG_LV_THEME_DEFAULT_DARK=y
# ★ 2026-10 改成 y。原来的注释写着"必须关闭（打开后 LVGL 按 12 字节遍历 glyph
#   描述符 → 全部空白）"，那条理由经核实是错的：lv_font_conv 产出的 .c 用的是
#   **指定初始化器** + LVGL 自己的 lv_font_fmt_txt_glyph_dsc_t 类型，描述符跨度由
#   编器按同一个头文件算出来，生成器与读取方**不可能**对不上（只有"预编译的 bin
#   分片 + 宿主开着 LARGE"这类跨编译单元才会错；本工程走 FONT_SRC_EMBEDDED，
#   .c 直接编进固件，不涉及）。LVGL 9.5 里开 LARGE 后 adv_w 是 **32 位**（不是
#   被挤成 8 位），box/ofs 变 16 位 —— 只有好处，没有那条"全部空白"。
#   真正的理由：lvgl_pinyin_ime 的 tools/gen_font.py 默认按**全字典字符集**生成
#   （17,266 字），20px/2bpp 的 glyph_bitmap[] 达 1.63 MB、16px 也有 1.06 MB，
#   都超过紧凑布局里 bitmap_index 的 20 位上限（1 MB）→ 编译期 -Woverflow 报错，
#   生成文件末尾还会 #error 让你打开本开关。组件文档也写明了这个前提。
#   代价：glyph 描述符 8 字节 → 16 字节，即 +8 B/字形（拼音两套约 +276 KB，
#   UI 三套位图字体约 +95 KB，合计约 +370 KB flash；app 分区仍有 40%+ 余量）。
#   想省这 370 KB 就要回到小字符集：
#     python tools/gen_charset.py --gb2312-only && python tools/gen_font.py --no-large-bitmap
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# 屏幕刷新周期：LVGL 默认 33 ms（30 FPS）。跟手动画的观感基本由帧率决定，
# 15 ms ≈ 66 FPS 是 esp_lvgl_adapter README 与乐鑫 LVGL 性能 FAQ 共同的推荐值。
CONFIG_LV_DEF_REFR_PERIOD=15
# 样式缓存：命中后省掉每次绘制时的样式链表查找，官方推荐的低风险提速项
CONFIG_LV_OBJ_STYLE_CACHE=y

# 性能显示器：屏幕右下角常驻 "xx FPS, xx% CPU"（LVGL 的 sysmon，画在 sys 层，
# 不会被本工程的 top 层 UI 遮住）。
# CPU 一栏是 LVGL 自身占用：本工程 LV_USE_OS = LV_OS_NONE，
# lv_os_get_idle_percent() 由 lv_os_none.c 提供（即 lv_timer_get_idle()），数值真实；
# **不要**改成 LV_OS_FREERTOS：那条实现靠 FreeRTOS 任务切换 trace 钩子累计空闲时间，
# 本工程没挂那些钩子，idle 会恒为 0，CPU 就永远显示 100%。
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y

# 绘制单元数量：esp_lvgl_adapter 的 PPA 加速要求保持 1（见 esp_lvgl_adapter
# README「PPA/DMA2D 加速」），因此**不要**为了多核并行改成 2。
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1

# PPA（Pixel Processing Accelerator，带 2D-DMA）硬件加速 —— **走 esp_lvgl_adapter
# 自己的实现，不开 LVGL 原生 PPA draw unit**。
#
# bsp_display.cc 把 disp_cfg.profile.enable_ppa_accel 置 true 后，esp_lvgl_adapter
# 会为 RGB565 注册自定义 blend/fill 处理器（lvgl_ppa_accel_v9.c），把填充与
# alpha 混合从 CPU 挪到 PPA —— 页面切换的滑屏动画（lv_screen_load_anim 的
# 两层合成）主要就吃这部分。这条路只依赖 CONFIG_SOC_PPA_SUPPORTED，不需要
# CONFIG_LV_USE_PPA。
#
# ⚠ 不要在这里开 CONFIG_LV_USE_PPA=y：那是 LVGL 9.5 自带的 espressif PPA draw
# unit，它要求 CONFIG_LV_DRAW_BUF_ALIGN == CONFIG_CACHE_L2_CACHE_LINE_SIZE，
# 且需要把 esp_driver_ppa 的头文件路径接进 lvgl 组件（9.5.0 的 CMake 没做），
# 实测开了会直接编译失败（#error + driver/ppa.h 找不到）。两个 PPA 是重复的，
# 用适配器那条就够了。

# ---------------------------------------------------------------------------
# 编译优化级别 —— 动画帧率的**头号因素**（本工程一直漏了这一项）
#
# 不写这一项时 IDF 用的是 -Og（"为调试优化"，几乎不做内联/强度削减），而 LVGL 是
# **纯软件渲染**：一帧 800×480 的滑屏动画要做几十万次填充/字形混合，渲染循环在
# -Og 下比 -O2/-Os 慢一倍以上 —— 表现就是"切页有点卡"。
# esp_lvgl_adapter README 也把 CONFIG_COMPILER_OPTIMIZATION_PERF 列在推荐配置里。
#
# 这里选 SIZE(-Os) 而不是 PERF(-O2)：app 分区只剩 ~31 KB 余量（输入法两套字体
# 占了 2.4 MB），-O2 的代码膨胀必然撑爆分区。而 -Os 同样开启了真正决定渲染速度的
# 那些优化（函数内联、寄存器分配、循环优化），只是禁掉体积膨胀的变换 —— 相对 -Og
# 是"又小又快"。以后若扩大了 app 分区，可以换成 PERF 再快一档。
#
# 副作用：栈回溯里的行号/变量会比 -Og 难读一些（发布固件可接受）。
# ---------------------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ---------------------------------------------------------------------------
# LVGL 用 C 库的 string / sprintf（esp_lvgl_adapter README 推荐项）
#   LVGL 自带的 lv_strlen/lv_snprintf 是逐字节的简化实现，标签排版、样式查找
#   这些热路径上调用很频繁；换成 newlib 的实现更快，而且省掉 LVGL 那份代码。
#   附带好处：lv_label_set_text_fmt("...%.1f MB") 的浮点格式化由 newlib 处理，
#   行为与 printf 完全一致。
# ---------------------------------------------------------------------------
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# ---------------------------------------------------------------------------
# LVGL 内存分配（本地音乐列表崩溃的根因所在，别改回去）
#
# 默认是 LVGL 内置堆，上限就是 CONFIG_LV_MEM_SIZE_KILOBYTES = 64 KB。
# 本地列表页 512 首 × 5 个控件 ≈ 2500 个对象，64 KB 必然不够；而一旦分配失败，
# LVGL 会执行 LV_ASSERT_MALLOC → LV_ASSERT_HANDLER，**默认实现就是 `while(1)`**，
# 直接把调用它的任务锁死（实测：看门狗反复报 "CPU 0: sd_scan"，
# 寄存器停在 lv_obj_allocate_spec_attr）。
#
# 改成 C 库 malloc：内存取自 ESP-IDF 堆，内部 RAM 用尽时会自动落到 PSRAM
# （CONFIG_SPIRAM_USE_MALLOC=y），并省掉 64 KB 常驻 .bss。
# 这也是 esp_lvgl_adapter README「推荐的 SDKCONFIG 配置」中的一条。
# ---------------------------------------------------------------------------
CONFIG_LV_USE_CLIB_MALLOC=y
# 分配失败只当"这个控件没建出来"，绝不死循环：设备上不能因为一次 OOM 就卡死
CONFIG_LV_USE_ASSERT_MALLOC=n

# UI 中文实际用 components/ui_font 里的位图字体 ui_font_sc16（GB2312 全集，
# 见 AGENTS.md 第 8 节）。下面这个内置 CJK 字体只含 1338 个常用汉字，
# 已经没有任何代码引用它，链接器会整块丢掉，不占 flash，因此保留默认值即可。
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_40=y

# ---------------------------------------------------------------------------
# 拼音输入法（lvgl_pinyin_ime）
#   词库放 dict 分区；用户词库放 usr 分区
# ---------------------------------------------------------------------------
CONFIG_LV_PINYIN_IME_DICT_SRC_PARTITION=y
CONFIG_LV_PINYIN_IME_USER_PARTITION="usr"

# ---------------------------------------------------------------------------
# 文件系统：microSD 音乐库走 FATFS，长文件名必须开
# ---------------------------------------------------------------------------
# 长文件名：关了就只能看到 8.3 短名（XXXXXX~1.MP3），中文全丢 —— 必须开
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# 文件名统一 UTF-8：readdir/fopen 收发的字符串编码。
# 默认是 ANSI/OEM(936=GBK)，于是中文歌名的路径是 **GBK 字节**，
# 直接丢给 UI（UTF-8 字体）和日志就是一片"��ѩ����"乱码。
CONFIG_FATFS_API_ENCODING_UTF_8=y
# CODEPAGE 只影响 8.3 短名怎么生成，主路径已经是 UTF-8 了；保留 936 让
# 中文名能生成可读的短名别名
CONFIG_FATFS_CODEPAGE_936=y

# ---------------------------------------------------------------------------
# 蓝牙音频（A2DP Source：本机推流给耳机/音箱）
# ---------------------------------------------------------------------------
# ESP-GMF 的 esp_bt_audio 要求打开 A2DP + 外部编码器（SBC 在应用层用
# esp_audio_codec 编码，是官方推荐的新设计）；AVRCP 由 BT_A2DP_ENABLE 自动
# select，这样耳机上的播放/暂停/上下曲也能收进来（AVRCP Target）。
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=y
# 内部 RAM 只有约 300 KB（Wi-Fi + LVGL + GMF 之后很紧张），Bluedroid 的堆优先
# 落到 16 MB PSRAM；官方 esp32s31 经典蓝牙示例同样打开这一项
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y

# ---------------------------------------------------------------------------
# 内存 / 任务
# ---------------------------------------------------------------------------
# 拼音输入法组件实测要求：app_main 栈 12288
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
# Wi-Fi/蓝牙事件都在 esp_event 的 sys_evt 任务里派发，默认栈只有 2304 字节。
# 扫描结果 + 一条 ESP_LOGI 就能把它爆掉（实测 "Stack protection fault in task
# sys_evt"）：现在扫描结果已经搬到 wifi_service 自己的工作线程，
# 这里再把 sys_evt 抬到 4096 作为第二道保险，两层都不省。
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# ---------------------------------------------------------------------------
# 分区表
# ---------------------------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---------------------------------------------------------------------------
# Watchdog
# ---------------------------------------------------------------------------
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# ---------------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ---------------------------------------------------------------------------
# 崩溃日志持久化（核心转储存 flash 的 coredump 分区）
# ---------------------------------------------------------------------------
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
# 网易云 API 服务地址（二维码登录/账号歌单/每日推荐）—— 见 main/Kconfig.projbuild
CONFIG_ONLINE_NETEASE_API_BASE="http://localhost:3000"

# 服务端访问鉴权 Token（Authorization: Bearer）—— 见 main/Kconfig.projbuild
CONFIG_ONLINE_NETEASE_API_TOKEN="sk-kP0pF3yD4gF6aP2qW3lJ2wD8gV9zO"

# ---------------------------------------------------------------------------
# 内置网易云 cookie（免扫码登录）—— 见 main/Kconfig.projbuild
#
# 路径是**相对工程根目录**的，构建时该文件被 EMBED 进固件，
# 设备端从中取 MUSIC_U / __csrf 用。留空 = 不启用（退回扫码登录）。
# ⚠ 这份 cookie 等于账号凭证，别连同 assets/ncm-ck.txt 一起提交到公开仓库。
# ---------------------------------------------------------------------------
CONFIG_ONLINE_NETEASE_CK_FILE="assets/ncm-ck.txt"

# ---------------------------------------------------------------------------
# 语音输入（lvgl_pinyin_ime 的讯飞语音听写）—— 2026-10
#
# menuconfig 路径：Component config -> lvgl_pinyin_ime -> Voice input (iFlytek IAT)
# 组件 Kconfig 里可配：ENABLE / APPID / APIKEY / APISECRET / ENDPOINT / LANGUAGE /
# DOMAIN / ACCENT / SAMPLE_RATE / EOS_MS / DWA / PUNCTUATION / LIVE_PREVIEW /
# COMMIT_MODE（追加|替换）/ TAP_MODE（切换|对讲|两者）/ KEY_K9。
#
# ⚠ 密钥写在这里 = 跟着固件一起发布，拿到固件就能提取出来。
#   量产/分享固件请只留 ENABLE 与端点，三个密钥在运行时用
#   lv_pinyin_ime_voice_set_config() 从 NVS / 服务器下发。
# ---------------------------------------------------------------------------
CONFIG_LV_PINYIN_IME_VOICE_ENABLE=y

# ---------------------------------------------------------------------------
# 图库 App（浏览器内图片浏览）所需的三个 LVGL 选项（2026-10）
# ---------------------------------------------------------------------------
# GIF：lv_gif 通过内存源播放（lv_gif_set_src 传 lv_image_dsc_t*，不走 LVGL 的
#   FS 驱动）—— 所以**不需要** CONFIG_LV_USE_FS_*。
CONFIG_LV_USE_GIF=y
# 双指捏合：LVGL 的手势识别器（lv_indev_gesture）要 LV_USE_FLOAT，
#   而它只有单精度浮点：S31 有硬件 FPU（SOC_CPU_HAS_FPU=1），float 是硬件指令，
#   所以打开它不会把 UI 拖慢。不开这两个就没有 PINCH 事件，双指缩放无从谈起。
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_GESTURE_RECOGNITION=y


# ---------------------------------------------------------------------------
# USB Host（UAC 声卡输出，见 docs/uac-audio.md）
#
# ⚠ 默认 256 字节**装不下这个声卡的配置描述符**（1 个 AudioControl + 4 个
#   AudioStreaming alt（16/24bit × 2）+ 1 个 HID 接口），枚举阶段直接失败：
#     E ENUM: Configuration descriptor larger than control transfer max length
#     E ENUM: CHECK_SHORT_CONFIG_DESC FAILED
#   → 设备永远"插着但认不到"（USB 主机栈自己都到不了类驱动那层）。
#   代价只有一个 1 KB 的内部 RAM 缓冲。
# ---------------------------------------------------------------------------
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024

# ---------------------------------------------------------------------------
# TLS 接收缓冲 16 KB → 8 KB（2026-10-21）
#
# 内部 RAM 现在同时供着：LVGL、PCM ringbuf、**UAC 环形缓冲 19.2 KB**、
# **ASRC 池 14 KB**、USB 三任务栈。MBEDTLS_INTERNAL_MEM_ALLOC=y 意味着 mbedTLS
# 的 TLS 缓冲**只能从内部 RAM 拿**，16 KB 的 in-buffer 一旦拿不到就：
#     E esp-aes: Failed to allocate memory
#     E esp-tls-mbedtls: write error :-0x0084
#     W online: GET failed (ESP_ERR_HTTP_WRITE_DATA)
# 8 KB 仍大于绝大多数服务器的 TLS 记录（常见 ≤4 KB），风险很低、直接省 8 KB。
# 不要降到 4 KB 以下：个别服务器会发 8/16 KB 记录，mbedTLS 会报 buffer_too_small。
# ---------------------------------------------------------------------------
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
